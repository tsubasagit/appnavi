# Firebase設定
# これらの値をFirebase Consoleから取得して設定してください
# https://console.firebase.google.com/
# 
# 使用方法:
# 1. このファイルをコピーして .env.local を作成
# 2. 各値を実際のFirebase設定値に置き換える
# 3. .env.local は .gitignore に含まれているため、Gitにはコミットされません

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# バックエンドプロキシAPI URL（本番環境用、CORSエラー回避）
# 例: https://us-central1-appnavi-add7e.cloudfunctions.net/getTemplates
# 未設定の場合は、開発環境ではViteプロキシ、本番環境では直接取得を試みます
VITE_PROXY_API_URL=
